// Lexical grammar for j--.

// Whitespace -- ignored
" " | "\t" | "\n" | "\r" | "\f"

// Single line comment -- ignored
"//" { ~( "\n" | "\r" ) } ( "\n" | "\r" ["\n"] )

// Multi-line comments -- ignored
"/*" { ~( "*/" ) } "*/"

// Reserved words
ABSTRACT       ::= "abstract"
ASSERT         ::= "assert"
BOOLEAN        ::= "boolean"
BREAK          ::= "break"
BYTE           ::= "byte"
CASE           ::= "case"
CATCH          ::= "catch"
CHAR           ::= "char"
CLASS          ::= "class"
CONST          ::= "const"
CONTINUE       ::= "continue"
DEFAULT        ::= "default"
DO             ::= "do"
DOUBLE         ::= "double"
ELSE           ::= "else"
ENUM           ::= "enum"
EXTENDS        ::= "extends"
FINAL          ::= "final"
FINALLY        ::= "finally"
FLOAT          ::= "float"
FOR            ::= "for"
FALSE          ::= "false"
GOTO           ::= "goto"
IF             ::= "if"
IMPLEMENTS     ::= "implements"
IMPORT         ::= "import"
INSTANCEOF     ::= "instanceof"
INT            ::= "int"
INTERFACE      ::= "interface"
LONG           ::= "long"
NATIVE         ::= "native"
NEW            ::= "new"
NULL           ::= "null"
PACKAGE        ::= "package"
PRIVATE        ::= "private"
PROTECTED      ::= "protected"
PUBLIC         ::= "public"
RETURN         ::= "return"
SHORT          ::= "short"
STATIC         ::= "static"
STRICTFP       ::= "strictfp"
SUPER          ::= "super"
SWITCH         ::= "switch"
SYNCHRONIZED   ::= "synchronized"
THIS           ::= "this"
THROW          ::= "throw"
THROWS         ::= "throws"
TRANSIENT      ::= "transient"
TRY            ::= "try"
TRUE           ::= "true"
VOID           ::= "void"
VOLATILE       ::= "volatile"
WHILE          ::= "while"

// Separators
COMMA          ::= ","
DOT            ::= "."
LBRACK         ::= "["
LCURLY         ::= "{"
LPAREN         ::= "("
RBRACK         ::= "]"
RCURLY         ::= "}"
RPAREN         ::= ")"
SEMI           ::= ";"

// Operators
ASSIGN         ::= "="
EQUAL          ::= "=="
DEC            ::= "--"
INC            ::= "++"
ASHR           ::= ">>"
ASHL           ::= "<<"
LSHR           ::= ">>>"

GT             ::= ">"
GTE            ::= "<="
LT             ::= "<"
LE             ::= "<="

LAND           ::= "&&"
LNOT           ::= "!"
LOR            ::= "||"

BAND           ::= "&"
BOR            ::= "|"
BXOR           ::= "^"

MINUS          ::= "-"
PLUS           ::= "+"
DIV            ::= "/"
STAR           ::= "*"
REM            ::= "%"

PLUS_ASSIGN    ::= "+="
MINS_ASSIGN    ::= "-="
STAR_ASSIGN    ::= "*="
DIV_ASSIGN     ::= "/="
REM_ASSIGN     ::= "%="
AND_ASSIGN     ::= "&="
OR_ASSIGN      ::= "|="
XOR_ASSIGN     ::= "^="
ASHL_ASSIGN    ::= "<<="
ASHR_ASSIGN    ::= ">>="
LSHR_ASSIGN    ::= ">>>="

// Identifiers
IDENTIFIER     ::= ( "a"..."z" | "A"..."Z" | "_" | "$" )
                       { "a"..."z" | "A"..."Z" | "_" | "0"..."9" | "$" }

// Literals
BYTE_LITERAL   ::= ( "0"..."9" ) { "0"..."9" }
SHORT_LITERAL  ::= ( "0"..."9" ) { "0"..."9" }
INT_LITERAL    ::= ( "0"..."9" ) { "0"..."9" }
OCTAL_INTEGER  ::= "0" { "0"..."9" }
HEX_INTEGER    ::= ( "0"  ( "x" | "X" )) ( "0"..."9" | "A"..."F" | "a"..."f" ) { "0"..."9" | "A"..."F" | "a"..."f" }
BINARY_INTEGER ::= ( "0"  ( "b" | "B" )) ("0" | "1" ) { "0" | "1" }
LONG_LITERAL   ::= ( "0"..."9" ) { "0"..."9" } [ "l" | "L" ]
FLOAT_LITERAL  ::= ( "0"..."9" ) { "0"..."9" } ["." ( "0"..."9" ) { "0"..."9" } ] [ "f" | "F" ]
DOUBLE_LITERAL ::= ( "0"..."9" ) { "0"..."9" } ["." ( "0"..."9" ) { "0"..."9" } ] [ "d" | "D" ]
ESC            ::= "\\" ( "n" | "r" | "t" | "b" | "f" | "'" | "\"" | "\\" )
STRING_LITERAL ::= "\"" { ESC | ~( "\"" | "\\" | "\n" | "\r" ) } "\""
CHAR_LITERAL   ::= "'" ( ESC | ~( "'" | "\n" | "\r" | "\\" ) ) "'"

// End of file
EOF            ::= "<end of file>"
